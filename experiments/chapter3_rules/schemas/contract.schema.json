{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract.schema.json",
  "title": "Target Microkernel Contract",
  "type": "object",
  "required": [
    "kernel_id", "dtype", "isa", "mr", "nr", "k_constraint",
    "input_layout", "output_layout", "stride", "alignment", "packing",
    "tail_policy", "call_convention", "fallback_path",
    "kernel_requirements", "adapter_capabilities", "verification_status"
  ],
  "properties": {
    "kernel_id": {"type": "string"},
    "dtype": {"type": "string"},
    "isa": {"type": "array", "items": {"type": "string"}},
    "mr": {"type": "integer", "minimum": 1},
    "nr": {"type": "integer", "minimum": 1},
    "k_constraint": {"type": "object"},
    "input_layout": {"type": "object"},
    "output_layout": {"type": "string"},
    "stride": {"type": "object"},
    "alignment": {"type": "object"},
    "packing": {"type": "object"},
    "tail_policy": {"type": "object"},
    "call_convention": {"type": "string"},
    "fallback_path": {"type": "string"},
    "kernel_requirements": {"type": "object"},
    "adapter_capabilities": {"type": "object"},
    "verification_status": {"type": "string"}
  }
}
