{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule.schema.json",
  "title": "Expert Rule",
  "type": "object",
  "required": [
    "rule_id", "category", "condition", "action", "parameter_domain",
    "strength", "priority", "source_fact_ids", "target_scope",
    "evidence_level", "conflict_policy", "provenance"
  ],
  "properties": {
    "rule_id": {"type": "string"},
    "category": {"enum": ["register_blocking", "cache_blocking", "packing", "vectorization", "tail_and_fallback"]},
    "condition": {"type": "string"},
    "action": {"type": "string"},
    "parameter_domain": {"type": "object"},
    "strength": {"type": "string"},
    "priority": {"type": "integer"},
    "source_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "target_scope": {"type": "object"},
    "evidence_level": {"enum": ["E1", "E2", "E3", "E4", "E5"]},
    "conflict_policy": {"type": "string"},
    "provenance": {"type": "string"}
  },
  "additionalProperties": false
}
