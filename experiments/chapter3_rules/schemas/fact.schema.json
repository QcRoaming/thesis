{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact.schema.json",
  "title": "Expert Fact",
  "type": "object",
  "required": [
    "fact_id", "operator", "dtype", "architecture", "library", "version",
    "source_file", "source_line", "source_symbol", "raw_value",
    "normalized_field", "normalized_value", "applicability",
    "evidence_level", "extraction_mode", "verification_status", "notes"
  ],
  "properties": {
    "fact_id": {"type": "string"},
    "operator": {"type": "string"},
    "dtype": {"type": "string"},
    "architecture": {"type": "string"},
    "library": {"type": "string"},
    "version": {"type": "string"},
    "source_file": {"type": "string"},
    "source_line": {"type": "integer", "minimum": 1},
    "source_symbol": {"type": "string"},
    "raw_value": {},
    "normalized_field": {"type": "string"},
    "normalized_value": {},
    "applicability": {"type": "object"},
    "evidence_level": {"enum": ["E1", "E2", "E3", "E4", "E5"]},
    "extraction_mode": {"enum": ["automatic", "derived", "manual", "empirical"]},
    "verification_status": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
