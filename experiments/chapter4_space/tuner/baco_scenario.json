{
  "application_name": "chapter4_expert_shell_matmul",
  "optimization_objectives": [
    "runtime_ms"
  ],
  "optimization_method": "bayesian_optimization",
  "optimization_iterations": 2,
  "design_of_experiment": {
    "doe_type": "random sampling",
    "number_of_samples": 4,
    "allow_repetitions": false
  },
  "models": {
    "model": "gaussian_process"
  },
  "GP_model": "gpy",
  "hyperparameter_optimization_iterations": 1,
  "acquisition_function": "EI",
  "normalize_inputs": true,
  "predict_noiseless": false,
  "allow_duplicate_samples": false,
  "local_search_random_points": 500,
  "local_search_starting_points": 5,
  "input_parameters": {
    "schedule_index": {
      "parameter_type": "ordinal",
      "values": [
        0,
        1,
        5,
        12,
        13,
        50
      ],
      "parameter_default": 0,
      "transform": "none"
    }
  },
  "feasible_output": {
    "enable_feasible_predictor": true,
    "name": "Valid",
    "true_value": "True",
    "false_value": "False"
  },
  "run_directory": "/buddy-mlir/jlq/thesis/experiments/chapter4_space/tuner/run",
  "log_file": "baco.log",
  "output_data_file": "baco_samples.csv"
}
